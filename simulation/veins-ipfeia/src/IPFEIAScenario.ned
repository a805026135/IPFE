package ipfeia;

import org.car2x.veins.nodes.RSU;
import org.car2x.veins.nodes.Scenario;

//
// Vehicular scenario: TraCI-managed vehicles (from SUMO), wireless RSUs and a
// wired application server reached through the RSU backhaul.
// The number and positions of RSUs are set by scenarios/rsu_positions.ini
// (generated by sumo/generate_scenario.py).
//
network IPFEIAScenario extends Scenario
{
    parameters:
        int numRsus = default(25);
    submodules:
        rsu[numRsus]: RSU {
            @display("i=veins/sign/yellowdiamond;is=vs");
        }
        as: ASApp {
            @display("i=device/server");
        }
}
