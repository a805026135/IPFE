#
# Build fragment for the IPFE-IA simulation subproject.
# Mirrors veins-src/src/makefrag (Windows linking + message compiler version).
#

ifneq (,$(filter win32 win32.x86_64,$(PLATFORM)))
  LDFLAGS += -lws2_32
  ENABLE_AUTO_IMPORT=-Wl,--enable-auto-import
  LDFLAGS := $(filter-out $(ENABLE_AUTO_IMPORT), $(LDFLAGS))

  # Our objects locally define some inline Veins symbols (vtable thunks,
  # inline virtuals like Coord::info) that libveins.dll also auto-exports,
  # so the linker sees them twice. The local copies are identical code, so
  # let the first (local) definition win.
  LDFLAGS += -Wl,--allow-multiple-definition
endif

# OMNeT++ 6 opp_msgtool still defaults to the legacy msg4 format (const char*
# getters); we want std::string-style getters for the C++ application code.
MSGCOPTS += --msg6
